          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ org_id: $('Collection completed').item.json.body.org_id, dataset_id: $('Collection completed').item.json.body.dataset_id }) }}"
