{
  "name": "NexusFlow 1 - Data Collection",
  "nodes": [
    {
      "id": "ebfb7ea6-e13b-5b2a-8914-b649a774eff3",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "53225e1d-621f-5cb2-a039-a145d068d442",
      "name": "Dispatch due workflows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api-internal:8001/internal/v1/automation/dispatch",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ limit: 100 }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "nexusflow-token---data-collection",
          "name": "NexusFlow token - data collection"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "d30128ad-bf93-5319-948f-50a95b1771f7",
      "name": "One item per run",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "dispatched",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Dispatch due workflows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch due workflows": {
      "main": [
        [
          {
            "node": "One item per run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "executionTimeout": 300,
    "timezone": "UTC",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "REPLACE_WITH_FAILURE_RECOVERY_WORKFLOW_ID"
  },
  "active": false,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    {
      "name": "nexusflow"
    }
  ]
}
