# Everything that runs or is parsed inside Linux containers keeps LF endings,
# even when the repository is cloned on Windows with core.autocrlf=true
# (a CRLF shell script breaks PostgreSQL's first boot, for example).
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.acl text eol=lf
*.html text eol=lf
*.lock text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf
.env.example text eol=lf
*.ps1 text eol=crlf

# Binary artefacts are never diffed or normalised.
*.png binary
*.jpg binary
*.gz binary
*.zip binary
*.pdf binary
*.xlsx binary
