# ---------------------------------------------------------------------------
# docker-compose.yml (production-like). Copy to .env and edit.
# Secrets are NOT configured here: run `make secrets`, which writes ./secrets
# (mounted as Docker secrets). Never commit .env or ./secrets.
# Every application setting is documented in docs/CONFIGURATION.md.
# ---------------------------------------------------------------------------
NEXUSFLOW_DOMAIN=nexusflow.example.com
# Directory holding fullchain.pem + privkey.pem for nginx (`make dev-certs` creates a
# local development CA and certificate here; use real certificates in production).
NEXUSFLOW_TLS_DIR=./deploy/certs
# JSON list of browser origins allowed to call the API (explicit https origins only)
NEXUSFLOW_CORS_ORIGINS=[]
# Set to false once the first organization exists; invite everyone else.
NEXUSFLOW_SIGNUP_ENABLED=
# Malware scanning of uploads: clamav:3310, with `docker compose --profile av up -d`.
NEXUSFLOW_CLAMAV_ADDRESS=
# The network between nginx and the API (the only source of trusted forwarded
# headers). Change it only if 172.28.1.0/24 is already used on the host.
NEXUSFLOW_EDGE_SUBNET=172.28.1.0/24
# "internal": the platform orchestrates the pipeline itself (works out of the box).
# "n8n": the n8n workflows drive it - switch only after provisioning them
# (workflows/n8n/README.md), otherwise events are forwarded to nothing.
NEXUSFLOW_ORCHESTRATION=internal
# Optional services, comma-separated: "av" (ClamAV), "n8n" (the workflow engine;
# set up its owner account the moment it first starts - docs/DEPLOYMENT.md, n8n).
# COMPOSE_PROFILES=av,n8n
# "offline" (heuristic analysis, no data leaves the platform) or "anthropic" (put
# the API key in ./secrets/ai_api_key). Tenants must still opt in to external AI,
# and datasets classified "restricted" are always analysed offline.
NEXUSFLOW_AI_PROVIDER=offline
NEXUSFLOW_OTLP_ENDPOINT=

# Outgoing e-mail (invitations, password resets, alerts, operator pages). TLS is
# mandatory: "starttls" (port 587) or "tls" (port 465). Leave the host empty to
# disable e-mail; the demo overlay (docker-compose.demo.yml) wires in Mailpit.
NEXUSFLOW_SMTP_HOST=
NEXUSFLOW_SMTP_PORT=587
NEXUSFLOW_SMTP_TLS_MODE=starttls
NEXUSFLOW_SMTP_USERNAME=
# The relay's password goes in ./secrets/smtp_password (created empty).
NEXUSFLOW_SMTP_FROM=alerts@nexusflow.example.com
# JSON list of addresses paged for platform incidents
NEXUSFLOW_OPERATOR_EMAILS=[]

# Images. Third-party images default to tags pinned to digests in the Compose
# files (`make pin-images` refreshes them). Set N8N_IMAGE, POSTGRES_IMAGE,
# REDIS_IMAGE, RABBITMQ_IMAGE, NGINX_IMAGE, ... only to override one on
# purpose - the whole reference with its digest, e.g.
# N8N_IMAGE=n8nio/n8n:2.40.6@sha256:<digest>.
# The application images are built locally by default. In production, run the
# signed release images by digest after verifying them (docs/DEPLOYMENT.md):
# NEXUSFLOW_IMAGE=ghcr.io/<owner>/nexusflow-ai:0.1.0@sha256:<digest>
NEXUSFLOW_IMAGE=nexusflow-ai:latest
NEXUSFLOW_BROWSER_IMAGE=nexusflow-browser:latest

# ---------------------------------------------------------------------------
# Local development (application on the host, infrastructure from
# docker-compose.dev.yml). Put these lines in .env.dev and load them with
# `set -a; . ./.env.dev; set +a` (plain `source` does not export them).
# The application reads process environment variables only - it never loads
# .env files itself. The *_FILE variables read the generated secrets.
# ---------------------------------------------------------------------------
# NEXUSFLOW_APP__ENVIRONMENT=development
# NEXUSFLOW_APP__PUBLIC_BASE_URL=http://localhost:8000
# NEXUSFLOW_DATABASE__URL=postgresql+asyncpg://nexusflow_app:<db_app_password>@localhost:5432/nexusflow
# NEXUSFLOW_DATABASE__MIGRATOR_URL=postgresql+asyncpg://nexusflow_migrator:<db_migrator_password>@localhost:5432/nexusflow
# NEXUSFLOW_REDIS__URL=redis://app:<password>@localhost:6379/0
# NEXUSFLOW_BROKER__URL=amqp://nexusflow:<password>@localhost:5672/nexusflow
# NEXUSFLOW_SECURITY__JWT_PRIVATE_KEY_FILE=./secrets/jwt_private_key
# NEXUSFLOW_SECURITY__ENCRYPTION_KEYS_FILE=./secrets/encryption_keys
# NEXUSFLOW_SECURITY__HMAC_PEPPER_FILE=./secrets/hmac_pepper
# NEXUSFLOW_N8N__ORCHESTRATION=internal
