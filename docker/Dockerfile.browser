# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
#
# Isolated JavaScript rendering service (Chromium via Playwright).
# Deployed on its own network segment, reachable only from the sandbox pool,
# with no access to the database, broker, Redis or any platform secret.

# Literal, digest-pinned FROM lines: the form Dependabot reads.
FROM ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc AS uv

FROM mcr.microsoft.com/playwright/python:v1.63.0-noble@sha256:72bd171a9ffc2b4b59532aaa6210e21014d07093120dc25528870c0b840da1f0
COPY --from=uv /uv /usr/local/bin/uv
# The Playwright base image is rebuilt upstream only occasionally, so apply the
# distribution's pending security updates (OpenSSL, for one) at build time,
# as the main Dockerfile already does.
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /build
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
# The base image's own Python tooling - the global pip and the virtualenv it
# used to install Playwright, their dependencies, and virtualenv's wheel cache
# (an unpacked pip with vendored setuptools and msgpack) - is never used at run
# time (the renderer runs from /opt/venv, isolated from the global packages)
# and would only carry vulnerabilities: it is deleted, and the build checks.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --extra browser \
 && rm -rf /build /usr/local/bin/uv \
 && rm -rf /usr/local/lib/python3*/dist-packages/* \
           /root/.cache/virtualenv /root/.cache/pip \
           /usr/local/bin/pip /usr/local/bin/pip3* /usr/local/bin/virtualenv \
 && test -z "$(ls -A /usr/local/lib/python3*/dist-packages)" \
 && ! /usr/bin/python3 -c "import pip" 2> /dev/null \
 && /opt/venv/bin/python -c "import playwright, nexusflow.apps.browser.app" \
 && groupadd --system --gid 10002 renderer \
 && useradd --system --uid 10002 --gid renderer --create-home --shell /usr/sbin/nologin renderer

ENV PATH=/opt/venv/bin:$PATH
WORKDIR /home/renderer
USER 10002:10002
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8090/health/live', timeout=4).status == 200 else 1)"]
CMD ["uvicorn", "nexusflow.apps.browser.app:create_browser_app", "--factory", \
     "--host", "0.0.0.0", "--port", "8090", "--no-proxy-headers", "--no-server-header", \
     "--limit-concurrency", "32"]
